# Server-side configuration only. Keep any existing connected inbox when deploying.
# If unset or blank, LEAD_NOTIFICATION_EMAIL defaults to anuragkeshav03@gmail.com.
LEAD_NOTIFICATION_EMAIL=anuragkeshav03@gmail.com
# business@aigrowlabs.media is always included by the backend.
# No second additional confirmed inbox has been supplied: leave this blank for now.
# Once confirmed, append extra inboxes here, separated by commas; do not replace
# LEAD_NOTIFICATION_EMAIL. Whitespace/case are normalized and duplicates removed.
# Invalid nonempty addresses fail the entire email attempt; do not use placeholders.
LEAD_NOTIFICATION_EMAILS=

# One Resend request sends all five form fields to all unique recipients in "to".
# Recipients can see each other's addresses. Both settings below are required.
# Verify your sender domain in Resend and use an API key with sending access.
# Example: EMAIL_FROM=AI Grow Lab <leads@aigrowlabs.media>
# Keep credentials in the private .env or host environment, never in the browser.
EMAIL_FROM=
RESEND_API_KEY=

# Google Sheets mirror via the included Google Apps Script.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SHARED_SECRET=

# Local development
HOST=127.0.0.1
PORT=8000
