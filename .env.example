# BACKEND ONLY: configure these on the active Render Python service, not Vercel.
# Append the second confirmed inbox to this comma-separated list before use.
# Example shape: business@aigrowlabs.media,SECOND_CONFIRMED_ADDRESS
# Replace SECOND_CONFIRMED_ADDRESS with the actual address; never use it literally.
LEAD_NOTIFICATION_EMAILS=business@aigrowlabs.media
# Preserve any existing legacy recipient on Render. It is merged, not replaced.
# No personal inbox is assumed when configuration is absent.
LEAD_NOTIFICATION_EMAIL=

# All recipients must be valid; whitespace/case are normalized and duplicates removed.
# business@aigrowlabs.media is always included. A second unique configured address is
# required. One Resend request sends the same lead to all addresses in "to" (max 50).
# Verify the sender domain in Resend. Both settings below are REQUIRED.
# Example: EMAIL_FROM=AI Grow Lab <leads@aigrowlabs.media>
# Keep the real key only in Render/private .env; never Git, browser code, or logs.
EMAIL_FROM=
RESEND_API_KEY=

# Optional Google Sheets mirror; it does not determine email success.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SHARED_SECRET=

# Reverse-proxy trust: empty for direct/local connections (ignores forwarded headers).
# On Render, verify the immediate ingress proxy and intermediate proxy CIDRs, then
# configure only those networks. X-Forwarded-For is read right-to-left through
# trusted hops. Do not guess ranges or trust 0.0.0.0/0 or ::/0 (both are rejected).
TRUSTED_PROXY_CIDRS=

# Rate limits are NOT disabled for tests: 5 requests/minute and 5 pending/accepted
# submissions/15 minutes per client IP (IPv6 grouped by /64). The SQLite database
# stores quotas atomically; mount data/ on a persistent disk for Render restarts/
# redeploys. Use a shared transactional store before scaling to separate instances.

# Local development only. On Render use HOST=0.0.0.0 and its assigned PORT.
HOST=127.0.0.1
PORT=8000
